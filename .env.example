SUPABASE_URL=
SUPABASE_KEY=
TRANSFER_API_URL=
TRANSFER_API_KEY=
CLIENT_API_KEY=
MODEL_NAME=gemini-2.5-flash

# 配置 DEEPSEEK_API_KEY 后改为官方直连；不要把真实 key 提交到仓库。
DEEPSEEK_API_KEY=
DEEPSEEK_THINKING=enabled
DEEPSEEK_REASONING_EFFORT=high
MEMORY_TOOL_REASONING_EFFORT=low

# Render Cron Job 每次运行一次 npm run heartbeat
HEARTBEAT_SESSION_ID=1
HEARTBEAT_CHARACTER_NAME=沈凛
HEARTBEAT_MODEL_NAME=gemini-2.5-flash
HEARTBEAT_COOLDOWN_HOURS=3
HEARTBEAT_CONTEXT_LIMIT=40
HEARTBEAT_TIMEOUT_MS=120000
HEARTBEAT_NIGHT_START_HOUR=2
HEARTBEAT_NIGHT_END_HOUR=8
HEARTBEAT_NIGHT_PUSH_GAP_HOURS=2
HEARTBEAT_DAY_PUSH_GAP_HOURS=0.5
TIME_ZONE=Asia/Shanghai

# iPhone 推荐 Bark；Android/跨平台可用 ntfy。
PUSH_PROVIDER=bark
BARK_KEY=
BARK_BASE_URL=https://api.day.app
BARK_GROUP=Kelivo
